# ── REQUIRED ─────────────────────────────────────────────────────────
GROQ_API_KEY=                              # REQUIRED — paste your key

# ── LLM ──────────────────────────────────────────────────────────────
GROQ_MODEL=openai/gpt-oss-120b

# ── Qdrant: file-store mode (default, no server) ─────────────────────
QDRANT_PATH=./qdrant_data

# Or HTTP mode (uncomment, then QDRANT_PATH is ignored):
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ── Embedding & rerank models ────────────────────────────────────────
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DEVICE=cpu                            # or mps / cuda

# ── Source paths (relative to chapter dir) ───────────────────────────
SELENIUM_REPO_DIR=./data/selenium_repo
SELENIUM_REPO_URL=https://github.com/PramodDutta/ATB14xSeleniumAdvanceFrameworks
PLAYWRIGHT_REPO_DIR=./data/playwright_repo
PLAYWRIGHT_REPO_URL=https://github.com/PramodDutta/Advance-Playwright-Framework
TESTCASES_CSV=./data/csv/VWO_TestCase.csv
PDFS_DIR=./data/pdf
JIRA_MD_DIR=./data/md
GENERATED_DIR=./data/generated

# ── Retrieval knobs ──────────────────────────────────────────────────
TOP_K_PER_COLLECTION=12
RERANK_TOP_K=4
RERANK_TOP_K_SIMILARITY=8
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PDF_CHUNK_SIZE=800
PDF_CHUNK_OVERLAP=120
HISTORY_TURNS=4
MIN_RERANK_SCORE=0.3
SESSION_TTL_MINUTES=30

# ── Scheduler ─────────────────────────────────────────────────────
INGEST_INTERVAL_MINUTES=60
# INGEST_CRON=0 * * * *          # optional cron (overrides interval if set)
